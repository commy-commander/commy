# Copy to .env (never commit it) and fill in. Only the first block is required.

# --- Required ---------------------------------------------------------------

# Public hostname. Point an A/AAAA record at this server first.
DOMAIN=commy.example.org
# Let's Encrypt account email for certificate expiry notices
ACME_EMAIL=admin@example.org
# openssl rand -hex 24  (hex keeps it URL safe)
POSTGRES_PASSWORD=
# openssl rand -base64 32  (rotating it signs everyone out)
BETTER_AUTH_SECRET=

# --- Sign-in providers (optional) -------------------------------------------

# Google OAuth client (Web application). Redirect URI:
#   https://<DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twitch application (https://dev.twitch.tv/console/apps, category Website
# Integration, client type Confidential). One app turns on two things: the
# "Sign in with Twitch" button and game search (IGDB). OAuth Redirect URL:
#   https://<DOMAIN>/api/auth/callback/twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# SMTP enables email verification, password reset and magic links. With it set,
# new email accounts must verify their address before they can sign in.
# Port 587 uses STARTTLS, 465 uses TLS from the start. The password is often an
# app-specific SMTP token from your mail provider, not your mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must be an address your SMTP user may send as; defaults to SMTP_USER
EMAIL_FROM=Commy <no-reply@example.org>
# Optional address that replies go to, for example a support mailbox
EMAIL_REPLY_TO=
# Or one URL instead of the four values above (URL-encode the password)
# SMTP_URL=smtp://user:password@smtp.example.org:587

# Cloudflare Turnstile bot check on sign-up, sign-in and password reset.
# Strongly recommended for public instances: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- GIF and game search (optional) -----------------------------------------

# Signed in apps search GIFs and games through this server, so users never need
# their own keys and the keys never reach the app. A search with no key is off
# and the app hides it; users can still add their own keys in its settings.
# The startup log line "[auth] ... gifs=on games=on" confirms what is enabled.
#
# GIFs: KLIPY key from https://partner.klipy.com/api-keys (Add Platform, then
# Create API Key). Test keys are rate limited; request production for a public
# instance.
KLIPY_API_KEY=
# Games: nothing to add when TWITCH_CLIENT_ID/SECRET above are set. Fill these
# only to use a separate Twitch app for IGDB (for example without Twitch sign-in).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- iroh relay (optional tuning) ------------------------------------------

# Relay hostname, defaults to relay.<DOMAIN>. In Cloudflare set it to DNS only
# (grey cloud) and open 8443/tcp and 7842/udp on the VPS firewall. Apps reach it
# at https://<RELAY_DOMAIN>:8443.
# RELAY_DOMAIN=relay.example.org
# RELAY_HTTPS_PORT=8443
# RELAY_QAD_PORT=7842
# Monthly relay budget in GB (sent + received). Keep it below your VPS plan's
# bandwidth so the website and system traffic have headroom.
RELAY_MONTHLY_LIMIT_GB=6000
# Alert at this share of the budget; stop new relay connections at the second
RELAY_WARN_PERCENT=75
RELAY_PAUSE_PERCENT=90
# Webhook URL for alerts (Slack, ntfy, Matrix hookshot or any JSON webhook)
ALERT_WEBHOOK_URL=

# --- Tuning (optional) ------------------------------------------------------

# Name shown in emails and the discovery document
COMMY_INSTANCE_NAME=Commy
# false closes registration; existing users can still sign in
ALLOW_SIGNUP=true
# Private preview: with a code set, the website asks for it before showing any
# page except the privacy policy, and new accounts (email, Google, Twitch, magic
# link) are refused without it. Case and spaces do not matter. Each browser asks
# once and remembers it for 90 days. Empty means open to everyone.
ACCESS_CODE=
# true makes creating invite links (https://<DOMAIN>/i/CODE) need a signed in app
INVITES_REQUIRE_ACCOUNT=false
# Most invite links that never expire (public servers) kept at once
INVITES_MAX_PERMANENT=20000
# false turns off the message doorbell, which tells an app that messages are
# waiting for it without learning who sent them or what they say (HOSTING.md)
DOORBELL=true
# Where doorbell rings and rate-limit counters live. The stack's own Redis by
# default; set it empty to keep rings in Postgres and counters in memory (then
# remove the redis service from docker-compose.yml).
#REDIS_URL=redis://redis:6379
# Sync service the apps use for end-to-end encrypted logs (HOSTING.md). Empty
# means the apps do not use it. Start it with `docker compose up -d sync`.
# SYNC_URL=wss://example.org/sync
# Days the sync service keeps sealed entries; 0 keeps everything
# SYNC_RETENTION_DAYS=90
# Firebase service account key (the JSON, or its base64) the sync service uses
# to wake Android phones with an empty push. Empty turns wake-ups off.
# FCM_SERVICE_ACCOUNT=
# Relay the web app at /web uses, comma separated. Empty means the production
# relay; a staging site sets https://relay-staging.<DOMAIN>:8443
# COMMY_RELAY_URLS=
# Optional read-only GitHub token so the downloads page never hits the API rate limit
# GITHUB_TOKEN=
# Docs redirect host, defaults to docs.<DOMAIN> (needs its own DNS record)
# DOCS_DOMAIN=docs.example.org
# Extra origins allowed to call the auth API with cookies, comma separated
# TRUSTED_ORIGINS=
# Override the public URL when not on standard ports, e.g. https://localhost:8443
# PUBLIC_URL=
# Host ports for Caddy
# HTTP_PORT=80
# HTTPS_PORT=443
