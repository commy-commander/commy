# Copy to .env (never commit it) and fill in. Only the first block is required.

# --- Required ---------------------------------------------------------------

# Public hostname. Point an A/AAAA record at this server first.
DOMAIN=commy.example.org
# Let's Encrypt account email for certificate expiry notices
ACME_EMAIL=admin@example.org
# openssl rand -hex 24  (hex keeps it URL safe)
POSTGRES_PASSWORD=
# openssl rand -base64 32  (rotating it signs everyone out)
BETTER_AUTH_SECRET=

# --- Sign-in providers (optional) -------------------------------------------

# Google OAuth client (Web application). Redirect URI:
#   https://<DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP enables magic links, email verification and password reset.
# Example: smtps://user:password@smtp.example.org:465
SMTP_URL=
EMAIL_FROM=Commy <no-reply@example.org>

# Cloudflare Turnstile bot check on sign-up, sign-in and password reset.
# Strongly recommended for public instances: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Tuning (optional) ------------------------------------------------------

# Name shown in emails and the discovery document
COMMY_INSTANCE_NAME=Commy
# false closes registration; existing users can still sign in
ALLOW_SIGNUP=true
# true makes creating invite links (https://<DOMAIN>/i/CODE) need a signed in app
INVITES_REQUIRE_ACCOUNT=false
# Optional read-only GitHub token so the downloads page never hits the API rate limit
# GITHUB_TOKEN=
# Docs redirect host, defaults to docs.<DOMAIN> (needs its own DNS record)
# DOCS_DOMAIN=docs.example.org
# Extra origins allowed to call the auth API with cookies, comma separated
# TRUSTED_ORIGINS=
# Override the public URL when not on standard ports, e.g. https://localhost:8443
# PUBLIC_URL=
# Host ports for Caddy
# HTTP_PORT=80
# HTTPS_PORT=443
