# Copy to .env (never commit it) and fill in. Only the first block is required.

# --- Required ---------------------------------------------------------------

# Public hostname. Point an A/AAAA record at this server first.
DOMAIN=commy.example.org
# Let's Encrypt account email for certificate expiry notices
ACME_EMAIL=admin@example.org
# openssl rand -hex 24  (hex keeps it URL safe)
POSTGRES_PASSWORD=
# openssl rand -base64 32  (rotating it signs everyone out)
BETTER_AUTH_SECRET=

# --- Sign-in providers (optional) -------------------------------------------

# Google OAuth client (Web application). Redirect URI:
#   https://<DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twitch application (https://dev.twitch.tv/console/apps, category Website
# Integration, client type Confidential). One app turns on two things: the
# "Sign in with Twitch" button and game search (IGDB). OAuth Redirect URL:
#   https://<DOMAIN>/api/auth/callback/twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Sign in with Apple. The Commy iPhone app works with no setup: leave
# APPLE_APP_BUNDLE_IDS empty to accept it (chat.commy.mobile), list other app
# IDs comma-separated, or set it to off. For the website button add a Services
# ID with return URL https://<DOMAIN>/api/auth/callback/apple and a Sign in
# with Apple key; APPLE_PRIVATE_KEY is the .p8 file's text on one line with \n
# between lines.
APPLE_APP_BUNDLE_IDS=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Passkeys in the phone apps. The server publishes
# /.well-known/apple-app-site-association for IOS_APP_IDS (empty means the
# Commy iPhone app, off turns it off) and /.well-known/assetlinks.json for the
# Android app once ANDROID_APP_CERT_SHA256 lists its signing certificate
# fingerprints (Play Console > App integrity > App signing, SHA-256).
IOS_APP_IDS=
ANDROID_APP_PACKAGE=
ANDROID_APP_CERT_SHA256=

# SMTP enables email verification, password reset and magic links. With it set,
# new email accounts must verify their address before they can sign in.
# Port 587 uses STARTTLS, 465 uses TLS from the start. The password is often an
# app-specific SMTP token from your mail provider, not your mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must be an address your SMTP user may send as; defaults to SMTP_USER
EMAIL_FROM=Commy <no-reply@example.org>
# Optional address that replies go to, for example a support mailbox
EMAIL_REPLY_TO=
# Postal address printed at the bottom of every email, as anti-spam laws such
# as CAN-SPAM ask of a sender
EMAIL_POSTAL_ADDRESS=
# Or one URL instead of the four values above (URL-encode the password)
# SMTP_URL=smtp://user:password@smtp.example.org:587

# Cloudflare Turnstile bot check on sign-up, sign-in and password reset.
# Strongly recommended for public instances: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Refuse sign-ups and email changes to known throwaway email services.
# Set to false to allow them.
BLOCK_THROWAWAY_EMAILS=true

# Refuse new passwords found in known data breaches, using the Have I Been
# Pwned range API. Only the first 5 characters of the password's SHA-1 hash
# are sent. If the check cannot be reached, the password is allowed and the
# auth log says so. Set to false to turn the check off.
CHECK_LEAKED_PASSWORDS=true

# --- GIF and game search (optional) -----------------------------------------

# Signed in apps search GIFs and games through this server, so users never need
# their own keys and the keys never reach the app. A search with no key is off
# and the app hides it; users can still add their own keys in its settings.
# The startup log line "[auth] ... gifs=on games=on" confirms what is enabled.
#
# GIFs: KLIPY key from https://partner.klipy.com/api-keys (Add Platform, then
# Create API Key). Test keys are rate limited; request production for a public
# instance.
KLIPY_API_KEY=
# Games: nothing to add when TWITCH_CLIENT_ID/SECRET above are set. Fill these
# only to use a separate Twitch app for IGDB (for example without Twitch sign-in).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- iroh relay (optional tuning) ------------------------------------------

# Relay hostname, defaults to relay.<DOMAIN>. In Cloudflare set it to DNS only
# (grey cloud) and open 8443/tcp and 7842/udp on the VPS firewall. Apps reach it
# at https://<RELAY_DOMAIN>:8443.
# RELAY_DOMAIN=relay.example.org
# RELAY_HTTPS_PORT=8443
# RELAY_QAD_PORT=7842
# Private IPv6 subnet for the shared relay's network (docker-compose.relay.yml),
# one per relay project on a host. With an AAAA record for RELAY_DOMAIN and the
# ports above open over IPv6, apps on IPv6-only networks reach the relay.
# RELAY_IPV6_SUBNET=fd99:6513:f442:1::/64
# Monthly relay budget in GB (sent + received). Keep it below your VPS plan's
# bandwidth so the website and system traffic have headroom.
RELAY_MONTHLY_LIMIT_GB=6000
# Alert at this share of the budget; stop new relay connections at the second
RELAY_WARN_PERCENT=75
RELAY_PAUSE_PERCENT=90
# Webhook URL for alerts (Slack, ntfy, Matrix hookshot or any JSON webhook)
ALERT_WEBHOOK_URL=
# Carry only apps signed in to this account server. Generate the token with
# `openssl rand -hex 32`; auth and the relay's access checker share it.
# RELAY_ACCESS_URL=http://relay-access:3342/ turns the check on in the relay.
# RELAY_ACCESS_MODE=watch only counts apps that would be refused (see
# usage data in relay_meter_data/access.json); enforce refuses them, and they
# use the public relays instead. If auth does not answer, apps are let in.
# RELAY_ACCESS_TOKEN=
# RELAY_ACCESS_URL=http://relay-access:3342/
# RELAY_ACCESS_MODE=watch

# --- Tuning (optional) ------------------------------------------------------

# Name shown in emails, the discovery document and the account pages
COMMY_INSTANCE_NAME=Commy
# The account pages (/account, /signup, /device, /i/CODE, /delete-account) come
# from the auth server and show your name, logo and legal links. Each is a path
# on this site (/terms) or a full https:// address; empty hides that link.
#COMMY_LOGO_URL=https://example.org/logo.svg
#COMMY_HOME_URL=/
#COMMY_TERMS_URL=https://example.org/terms
#COMMY_PRIVACY_URL=https://example.org/privacy
#COMMY_DOWNLOAD_URL=https://commy.chat/download
# false closes registration; existing users can still sign in
ALLOW_SIGNUP=true
# Private preview: with a code set, the website asks for it before showing any
# page except the privacy policy, and new accounts (email, Google, Twitch, magic
# link) are refused without it. Case and spaces do not matter. Each browser asks
# once and remembers it for 90 days. Empty means open to everyone.
ACCESS_CODE=
# true refuses new accounts (email, Google, Twitch, magic link) unless the
# person ticks "I am 18 or older and I agree to the Terms" when signing up,
# and stores when they did.
ADULTS_ONLY=true
# The account server signs a "home card" for each signed-in app so other
# people can see, and check, which account server someone uses. Its key is
# published in /.well-known/commy-auth.json. Empty derives a stable key from
# BETTER_AUTH_SECRET (changing that secret changes the key); set 64 hex
# characters (openssl rand -hex 32) to keep the key across secret changes.
# The official apps carry commy.chat's public key and show the verified
# badge only when the server signs a fresh check with it, so commy.chat's
# key may change only after apps carrying the new key have shipped.
AUTH_SERVER_KEY=
# The key that signs this server's list of blocked servers
# (/api/auth/commy/server-blocklist). Empty derives one from
# BETTER_AUTH_SECRET. The official apps read only commy.chat's list.
COMMY_LIST_KEY=
# Folder holding servers.txt: one blocked server domain per line, optionally
# followed by the date it was added (2026-11-15), # starts a note. Subdomains
# are blocked too. The auth server rereads it within a minute of a change.
SERVER_BLOCKLIST_DIR=./server-blocklist
# Where people report abuse on this server: an email address or an https://
# page. It is published in the discovery document, and a listed server must
# have one that a person answers within 72 hours (see LISTING.md).
#COMMY_ABUSE_CONTACT=abuse@example.org
# on runs the list of community servers (LISTING.md): the application form at
# /servers/apply, its checks, monthly re-checks and the signed list the apps
# read. Only the official commy.chat servers turn it on.
#LISTING=off
# Receives each application that passes its checks, with review links
#LISTING_REVIEW_EMAIL=
# Oldest release a listed server may run; empty means one minor release
# behind this server's own release
#LISTING_OLDEST_VERSION=
# The Terms of Service version (for example its date) stored with each
# account's acceptance at sign-up. Change it when the Terms change.
TERMS_VERSION=2026-10-25
# true makes creating invite links (https://<DOMAIN>/i/CODE) need a signed in app
INVITES_REQUIRE_ACCOUNT=false
# Most invite links that never expire (public servers) kept at once
INVITES_MAX_PERMANENT=20000
# false turns off the message doorbell, which tells an app that messages are
# waiting for it without learning who sent them or what they say (HOSTING.md)
DOORBELL=true
# Where doorbell rings and rate-limit counters live. The stack's own Redis by
# default; set it empty to keep rings in Postgres and counters in memory (then
# remove the redis service from docker-compose.yml).
#REDIS_URL=redis://redis:6379
# Proxies allowed to tell the auth server a visitor's address with
# X-Forwarded-For, as comma-separated IP addresses or CIDR ranges. Empty trusts
# private and loopback networks, which covers the bundled Caddy; none trusts no
# proxy and counts every connection by its own address (HOSTING.md)
#TRUSTED_PROXIES=
# Sync service the apps use for end-to-end encrypted logs (HOSTING.md). Empty
# means the apps do not use it. Start it with `docker compose up -d sync`.
# SYNC_URL=wss://example.org/sync
# Days the sync service keeps sealed entries; 0 keeps everything
# SYNC_RETENTION_DAYS=90
# Database connections the sync service keeps open (1 to 200). Leave room
# under Postgres max_connections (100 by default) for the auth server
# SYNC_DB_POOL=24
# Auth server whose new server passes the sync service takes (HOSTING.md).
# Empty means https://<DOMAIN>, this stack's own; none turns passes off.
# SYNC_PASS_ISSUER=
# true refuses new logs that come without a pass. Leave it off until every
# app in use is 1.0 or later
# SYNC_PASSES_REQUIRED=false
# Where people reach you about content the sync service stores: an email
# address or an https:// page. Reports from the apps come to the sync service
# (docker compose exec sync commy-sync reports) and, with SMTP set, by email.
# SYNC_ABUSE_CONTACT=abuse@example.org
# Report key: with it set, apps seal each report so this server, its database,
# backups and report emails hold only the community id, reason and log ids.
# Make one with: docker compose run --rm --no-deps sync commy-sync report-key
# and keep the secret line it prints on your own computer (HOSTING.md).
# SYNC_REPORT_KEY=
# Name the apps show for whoever runs this sync service; defaults to
# COMMY_INSTANCE_NAME
# SYNC_OPERATOR_NAME=
# Relay that apps use for voice in the communities this sync service holds.
# Empty means https://<DOMAIN>, served by this stack's relay at /relay.
# SYNC_RELAY_URL=
# When that relay does not answer: pause stops voice there until it answers,
# public moves it to the free public relays. Commy's relay is never used.
# SYNC_RELAY_FALLBACK=pause
# Admin page password (16 characters or more) on 127.0.0.1:8790; empty turns
# the page off. Open it through an SSH tunnel (HOSTING.md).
# SYNC_ADMIN_PASSWORD=
# SYNC_ADMIN_HOST_PORT=8790
# Push gateway: lets other Commy servers wake phones through this one's push
# keys. Each server proves itself with its signed server key, gets a daily cap
# that grows with a clean record, and is cut off on its own if it floods.
# Leave off unless you hold the app's push keys (DEPLOYING.md).
# SYNC_PUSH_GATEWAY=off
# Pings a day across every server; alerts go to ALERT_WEBHOOK_URL and the
# abuse contact at the alert share and when it runs out
# SYNC_GATEWAY_DAILY_BUDGET=100000
# SYNC_GATEWAY_ALERT_PERCENT=75
# Whose signed server blocklist the gateway follows; servers on it are refused.
# Empty means https://commy.chat, off follows none.
# SYNC_GATEWAY_BLOCKLIST=
# Without push keys of your own, wake phones through another server's push
# gateway instead, such as https://commy.chat. Your server signs each request
# with its server key, and that gateway's daily caps apply (HOSTING.md).
# SYNC_PUSH_VIA=off
# Firebase service account key (the JSON, or its base64) the sync service uses
# to wake Android phones with an empty push. Empty turns wake-ups off.
# FCM_SERVICE_ACCOUNT=
# Apple push key (the .p8 text, or its base64), its Key ID and your Apple team
# ID, which the sync service uses to wake iPhones. APNS_TOPIC is the app's
# bundle id (chat.commy.mobile when empty). Empty APNS_KEY turns iPhone
# wake-ups off.
# APNS_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=
# Relay the web app at /web uses, comma separated. Empty means the production
# relay; a staging site sets https://relay-staging.<DOMAIN>:8443
# COMMY_RELAY_URLS=
# Optional read-only GitHub token so the downloads page never hits the API rate limit
# GITHUB_TOKEN=
# Docs redirect host, defaults to docs.<DOMAIN> (needs its own DNS record)
# DOCS_DOMAIN=docs.example.org
# Extra origins allowed to call the auth API with cookies, comma separated
# TRUSTED_ORIGINS=
# Override the public URL when not on standard ports, e.g. https://localhost:8443
# PUBLIC_URL=
# Host ports for Caddy
# HTTP_PORT=80
# HTTPS_PORT=443
