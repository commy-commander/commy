{
	email {$ACME_EMAIL}
}

(relay) {
	@upgrade_without_connection_header header Upgrade *
	request_header @upgrade_without_connection_header Connection Upgrade
	reverse_proxy {args[0]}:3341
}

{$RELAY_DOMAIN}:8443 {
	import relay commy-relay-proxy
}

{$STAGING_RELAY_DOMAIN}:8443 {
	import relay commy-relay-staging-proxy
}

https://:8443 {
	@relay_name_with_trailing_dot header_regexp Host ^{$RELAY_DOMAIN}\.(:[0-9]+)?$
	handle @relay_name_with_trailing_dot {
		import relay commy-relay-proxy
	}
	@staging_relay_name_with_trailing_dot header_regexp Host ^{$STAGING_RELAY_DOMAIN}\.(:[0-9]+)?$
	handle @staging_relay_name_with_trailing_dot {
		import relay commy-relay-staging-proxy
	}
	handle {
		abort
	}
}
