{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	@auth path /api/auth/* /.well-known/commy-auth.json
	handle @auth {
		reverse_proxy auth:3001
	}

	handle {
		reverse_proxy web:3000
	}
}

{$DOCS_DOMAIN} {
	redir https://{$DOMAIN}/docs{uri} permanent
}

{$RELAY_DOMAIN}:8443 {
	@upgrade header Upgrade *
	request_header @upgrade Connection Upgrade
	reverse_proxy relay-proxy:3341
}

https://:8443 {
	@relay header_regexp Host ^{$RELAY_DOMAIN}\.(:[0-9]+)?$
	handle @relay {
		@upgrade header Upgrade *
		request_header @upgrade Connection Upgrade
		reverse_proxy relay-proxy:3341
	}
	handle {
		abort
	}
}
