{
  "name": "commy-streamdeck",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "validate": "streamdeck validate chat.commy.soundboard.sdPlugin --no-update-check",
    "pack": "streamdeck pack chat.commy.soundboard.sdPlugin --output dist --force --no-update-check"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.3"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.3",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.1",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.2",
    "rollup": "4.65.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
