<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>chat.commy.desktop</id>
  <name>Commy</name>
  <summary>Voice, video and chat for your communities</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <developer id="chat.commy">
    <name>Commy</name>
  </developer>
  <description>
    <p>
      Commy is an open source place to talk with your friends and communities. Make servers with
      text and voice channels, share your screen or a game, and send files.
    </p>
    <p>
      Messages are end-to-end encrypted, and voice, video, screen sharing and files go straight
      between the people in the call.
    </p>
  </description>
  <launchable type="desktop-id">chat.commy.desktop.desktop</launchable>
  <url type="homepage">https://commy.chat</url>
  <url type="vcs-browser">https://git.commy.chat/commy/commy</url>
  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
    <category>Chat</category>
  </categories>
  <requires>
    <display_length compare="ge">940</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
