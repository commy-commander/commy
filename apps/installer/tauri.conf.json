{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Commy Setup",
  "version": "0.1.0",
  "identifier": "chat.commy.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Commy Setup",
        "width": 640,
        "height": 400,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#090a0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../desktop/src-tauri/icons/icon.ico", "../desktop/src-tauri/icons/icon.png"]
  }
}
